# ─────────────────────────────────────────────────────────────────────────────
# RAG Mutual Fund FAQ Assistant — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Configuration (Groq) ─────────────────────────────────────────────────
# Provider: groq
LLM_PROVIDER=groq

# Model: llama-3.1-8b-instant (default) | mixtral-8x7b-32768 (complex queries)
LLM_MODEL=llama-3.1-8b-instant

# Get your free API key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Temperature: 0.0–0.2 for deterministic, factual output
LLM_TEMPERATURE=0.1

# Max output tokens — enforces ≤ 3-sentence responses
LLM_MAX_TOKENS=150

# ── Embedding Configuration (BGE — runs locally, no API key required) ─────────
# Use bge-small for development (faster), bge-large for production (better quality)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
VECTORSTORE_PATH=./data/vectorstore
VECTORSTORE_COLLECTION=mf_faq_v1

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of top chunks to retrieve
RETRIEVAL_TOP_K=5

# Minimum similarity score to include a chunk (0.0–1.0)
RETRIEVAL_SCORE_THRESHOLD=0.65

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Deployment (filled in after Phase 5) ─────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-app.up.railway.app
