# ─────────────────────────────────────────────
# RAG Mutual Fund FAQ Assistant — .gitignore
# ─────────────────────────────────────────────

# ── Secrets — NEVER commit ───────────────────
.env
*.key
*.pem
secrets/

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# ── Virtual Environments ─────────────────────
venv/
.venv/
env/
ENV/
.env.local
.env.*.local

# ── Vector Store (committed to Git for Railway deployment) ────────────────
# data/vectorstore/  ← intentionally tracked so Railway has data on deploy

# ── Pytest / Testing ─────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── IDEs & Editors ───────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Type checking ─────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Raw fetched content (audit trail — optional) ─
data/raw/

# ── Stray test vectorstore directories ────────
_nonexistent_vs_test/

# ── Deployment artifacts ───────────────────────
nixpacks.toml
.railway/
.vercel/

# ── Log files ─────────────────────────────────
*.log
logs/

